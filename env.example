# Server
PORT=5000
NODE_ENV=development

# SQL Server Database (Azure SQL, AWS RDS for SQL Server, or any cloud-hosted MSSQL)
DB_HOST=110.227.194.109
DB_PORT=2739
DB_NAME=sbh_hospital
DB_USER=appadm
DB_PASSWORD=ad@0808
# Most cloud SQL Server providers require an encrypted connection (default: true).
DB_ENCRYPT=true
# Only set to true for a local/self-signed SQL Server without a valid TLS cert.
DB_TRUST_SERVER_CERTIFICATE=false

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Default admin (used by `npm run seed`)
DEFAULT_ADMIN_NAME=Super Admin
DEFAULT_ADMIN_EMAIL=admin@sbhhospital.com
DEFAULT_ADMIN_PASSWORD=Admin@123

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Public base URL of this backend (used to build absolute file URLs)
PUBLIC_URL=https://sbh-api.vercel.app

# Vercel Blob storage (required for doctor/gallery/blog/resume file uploads)
# Create a Blob store in your Vercel project's Storage tab, connect it to this
# project, then copy the token it generates here (and in Vercel's env settings).
BLOB_READ_WRITE_TOKEN=

# Gmail SMTP (used to email HR when a career application is submitted)
# 1. Enable 2-Step Verification on the Gmail account you want to send from.
# 2. Create an App Password at https://myaccount.google.com/apppasswords
# 3. Put that 16-character app password below (NOT the normal Gmail password).
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
# Recipient for new career-application notifications
HR_EMAIL=dme@sbhhospital.com
